# ==============================================================================
# RAAHDOST ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# All keys below are optional for local testing. The application includes a
# self-contained reactive fallback engine (BroadcastChannel + Leaflet OSM +
# Mangalore demo dataset) that runs 100% offline out-of-the-box.
# ==============================================================================

# 1. SUPABASE / FIREBASE REALTIME BACKEND (Optional)
# For production live multi-user database & Google OAuth authentication:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. GOOGLE MAPS API (Optional)
# For Google Maps JavaScript API, Places Autocomplete, and Directions API:
# If left empty, RaahDost seamlessly falls back to high-resolution Leaflet OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# 3. AI STUDENT GUIDE AGENT (Optional)
# For generative conversational queries with Gemini Live / Flash:
# If left empty, RaahDost uses its built-in deterministic transit reasoning engine.
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# 4. APPLICATION METADATA
VITE_APP_URL=http://localhost:4173
VITE_APP_NAME=RaahDost
VITE_DEMO_MODE=true
