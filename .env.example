# ==============================================================================
# RAAHDOST ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# RaahDost uses 100% free, open mapping tools:
# - Leaflet with OpenStreetMap tiles (No API key, zero billing)
# - Nominatim for geocoding & address search (OpenStreetMap, free)
# - OSRM (Open Source Routing Machine) for road routing & ETAs (free public server)
# The application runs completely free without requiring any paid map service.
# ==============================================================================

# 1. SUPABASE REALTIME BACKEND (Optional)
# For production live multi-user database & authentication:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. FREE OPEN ROUTING CONFIGURATION (Optional - defaults to public demo server)
# Public OSRM routing endpoint (default: https://router.project-osrm.org/route/v1/driving)
VITE_OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
# Optional OpenRouteService key if extra avoid-area features are desired (not required):
VITE_OPENROUTESERVICE_API_KEY=

# 3. AI AGENT (Optional)
# For Gemini Flash & Flash-Lite conversational queries:
# If left empty, RaahDost seamlessly uses its grounded 15-tool transit reasoning engine.
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# 4. APPLICATION METADATA & TIMEZONE
VITE_APP_URL=http://localhost:4173
VITE_APP_NAME=RaahDost
VITE_TIMEZONE=Asia/Kolkata
VITE_DEMO_MODE=true
